{
  "enabled": true,
  "provider": "openrouter",
  "fallbackProviders": ["anthropic"],
  "includePaths": ["packages/**", "scripts/**", ".github/**", "README.md"],
  "excludePaths": [
    "**/fixtures/**",
    "**/dist/**",
    "packages/*/data/**",
    "packages/*/src/**/data/**"
  ],
  "scanForSecretsBeforeSending": true,
  "onSensitiveContent": "block"
}
